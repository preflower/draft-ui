{
  "name": "@draft-ui/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "draft-vue": "./dist/vue.js",
    "draft-react": "./dist/react.js"
  },
  "scripts": {
    "build": "tsup src/bin/vue.ts src/bin/react.ts --format esm --clean --dts",
    "dev": "tsup src/bin/vue.ts src/bin/react.ts --format esm --watch --clean"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "ora": "^7.0.1",
    "prompts": "^2.4.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.5",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "register": "https://raw.githubusercontent.com/preflower/draft-ui/main"
}
