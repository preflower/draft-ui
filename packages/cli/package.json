{
  "name": "draft-cli",
  "version": "0.1.0",
  "private": false,
  "description": "A command-line tool for adding components to your Vue and React projects. Inspired by shadcn/ui.",
  "license": "MIT",
  "homepage": "https://preflower.github.io/draft-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/preflower/draft-ui.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "ui-kit",
    "vue",
    "react",
    "cli",
    "shadcn"
  ],
  "bin": {
    "draft-cli": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/bin/index.ts --format esm --clean --dts",
    "dev": "tsup src/bin/index.ts --format esm --watch --clean"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "ora": "^7.0.1",
    "prompts": "^2.4.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.5",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "register": "https://raw.githubusercontent.com/preflower/draft-ui/main"
}
